class BankAccount {
    String name;
    double balance;

    void deposit(double amount) {
        balance += amount;
    }

    void display() {
        System.out.println("Name: " + name);
        System.out.println("Balance: " + balance);
    }

    public static void main(String[] args) {
        BankAccount b = new BankAccount();
        b.name = "David";
        b.balance = 5000;
        b.deposit(2000);
        b.display();
    }
}
