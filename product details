class Product {
    int id;
    String name;
    int price;

    void display() {
        System.out.println("Product ID: " + id);
        System.out.println("Product: " + name);
        System.out.println("Price: " + price);
    }

    public static void main(String[] args) {
        Product p = new Product();
        p.id = 10;
        p.name = "Laptop";
        p.price = 55000;
        p.display();
    }
}
